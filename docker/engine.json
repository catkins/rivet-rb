{
  "auth": { "admin_token": "dev" },
  "guard": { "host": "0.0.0.0" },
  "api_peer": { "host": "0.0.0.0", "advertise_address": "engine:6421" },
  "storage": {
    "log_directory": "/data",
    "auto_provision_partitions": 1,
    "log_shard": { "max_disk_bytes": 1073741824 },
    "cold_store": { "disk_cache_bytes": 268435456 }
  },
  "object_storage": {
    "primary": {
      "s3": {
        "bucket": "rivet-engine-preview",
        "region": "us-east-1",
        "endpoint": "http://s3:9000",
        "access_key_id": "rivetdev",
        "secret_access_key": "rivetdev-local-password"
      }
    }
  },
  "telemetry": { "enabled": false },
  "outbound": { "allow_private_networks": true },
  "topology": {
    "datacenter_label": 1,
    "datacenters": {
      "default": {
        "datacenter_label": 1,
        "is_leader": true,
        "public_url": "http://engine:6420",
        "peer_url": "http://engine:6421",
        "valid_hosts": ["engine", "127.0.0.1", "localhost"]
      }
    }
  }
}
